{
  "$schema": "https://predivo.ch/schemas/design-tokens/v1",
  "$description": "Canonical design tokens for [PROJECT_NAME]. Single source of truth — all other design docs derive from this file.",
  "$version": "1.0.0",
  "$lastAudit": "YYYY-MM-DD",

  "color": {
    "$description": "All colors. Use CSS variables or Tailwind tokens — never hardcode hex in components.",

    "ink": {
      "$description": "Text colors, ordered by emphasis (highest to lowest).",
      "default":  { "$value": "#1C1D1F", "$tailwind": "text-ink",       "$description": "Primary text, headings" },
      "sub":      { "$value": "#232529", "$tailwind": "text-ink-sub",   "$description": "Subheadings" },
      "body":     { "$value": "#505967", "$tailwind": "text-ink-body",  "$description": "Body text" },
      "muted":    { "$value": "#6B7280", "$tailwind": "text-ink-muted", "$description": "Captions, placeholders, icons" }
    },

    "surface": {
      "$description": "Background colors.",
      "default": { "$value": "#FFFFFF", "$tailwind": "bg-surface",       "$description": "Primary background" },
      "alt":     { "$value": "#FAFAFB", "$tailwind": "bg-surface-alt",   "$description": "Alternate sections, hero" },
      "hover":   { "$value": "#F3F4F6", "$tailwind": "bg-surface-hover", "$description": "Hover state, tile bg" }
    },

    "edge": {
      "$description": "Border and divider colors.",
      "default": { "$value": "#D3D8DF", "$tailwind": "border-edge",         "$description": "Default border" },
      "subtle":  { "$value": "#E4E7EC", "$tailwind": "border-edge-subtle",  "$description": "Dividers, separators" },
      "outline": { "$value": "#CAD0D9", "$tailwind": "border-edge-outline", "$description": "Outline button border" }
    },

    "accent": {
      "$description": "Brand accent color. Adjust hue/saturation per project.",
      "default": { "$value": "#2563EB", "$description": "Links, focus rings, data viz" },
      "hover":   { "$value": "#1D4ED8", "$description": "Hover state" },
      "light":   { "$value": "#DBEAFE", "$description": "Light accent backgrounds" }
    },

    "status": {
      "$description": "Semantic status colors. Tailwind standard recommended.",
      "error":   { "$value": "#EF4444" },
      "success": { "$value": "#22C55E" },
      "warning": { "$value": "#F59E0B" }
    },

    "button": {
      "$description": "Button-specific colors. Adjust per project.",
      "primary-bg":   { "$value": "#222222", "$description": "Primary CTA background" },
      "primary-text": { "$value": "#FFFFFF", "$description": "Primary CTA text" }
    }
  },

  "typography": {
    "fontFamily": {
      "sans":  { "$value": "Inter, system-ui, sans-serif",           "$description": "UI text" },
      "serif": { "$value": "Georgia, serif",                         "$description": "Quotes, testimonials (optional)" },
      "mono":  { "$value": "JetBrains Mono, ui-monospace, monospace", "$description": "Code, data values (optional)" }
    },

    "scale": {
      "display":   { "size": "3.5rem",    "lineHeight": "1.08", "letterSpacing": "-0.02em", "fontWeight": 700 },
      "heading-1": { "size": "2.5rem",    "lineHeight": "1.15", "letterSpacing": "-0.01em", "fontWeight": 700 },
      "heading-2": { "size": "1.875rem",  "lineHeight": "1.2",  "letterSpacing": "-0.01em", "fontWeight": 600 },
      "heading-3": { "size": "1.5rem",    "lineHeight": "1.3",  "letterSpacing": "0",       "fontWeight": 600 },
      "body-lg":   { "size": "1.125rem",  "lineHeight": "1.6",  "letterSpacing": "0",       "fontWeight": 400 },
      "body":      { "size": "1rem",      "lineHeight": "1.6",  "letterSpacing": "0",       "fontWeight": 400 },
      "body-sm":   { "size": "0.875rem",  "lineHeight": "1.5",  "letterSpacing": "0",       "fontWeight": 400 },
      "caption":   { "size": "0.75rem",   "lineHeight": "1.4",  "letterSpacing": "0.01em",  "fontWeight": 500 }
    }
  },

  "layout": {
    "container": {
      "maxWidth": "1400px",
      "padding": {
        "mobile":  "24px",
        "tablet":  "32px",
        "desktop": "64px"
      }
    },
    "navbar": { "height": "56px" },
    "section": {
      "verticalPadding": "80-120px",
      "gap": "0px"
    },
    "breakpoints": {
      "sm": "640px",
      "md": "768px",
      "lg": "1024px",
      "xl": "1280px",
      "2xl": "1536px"
    }
  },

  "borderRadius": {
    "base": { "$value": "0.625rem", "$computed": "10px", "$description": "CSS --radius variable" },
    "lg":   { "$value": "10px", "$description": "Cards" },
    "md":   { "$value": "8px",  "$description": "Buttons, inputs" },
    "sm":   { "$value": "6px",  "$description": "Small elements" },
    "pill": { "$value": "9999px", "$description": "Badges, pills" }
  },

  "shadow": {
    "$description": "Shadow scale using rgba. Adjust opacity per project.",
    "xs":  { "$value": "0 1px 2px rgba(0,0,0,0.04)" },
    "sm":  { "$value": "0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04)" },
    "md":  { "$value": "0 4px 8px -2px rgba(0,0,0,0.06), 0 2px 4px -2px rgba(0,0,0,0.04)" },
    "lg":  { "$value": "0 12px 24px -4px rgba(0,0,0,0.06), 0 4px 8px -2px rgba(0,0,0,0.04)" },
    "xl":  { "$value": "0 20px 40px -8px rgba(0,0,0,0.08), 0 8px 16px -4px rgba(0,0,0,0.04)" },
    "2xl": { "$value": "0 32px 64px -12px rgba(0,0,0,0.10)" }
  },

  "animation": {
    "entrance": {
      "duration": "0.6s",
      "easing": "ease-out",
      "translate": "24px",
      "$description": "Section fade-up on scroll"
    },
    "stagger": { "children": "0.08s" },
    "transition": {
      "color": "150ms",
      "buttonPress": "50ms",
      "navBlur": "0.3s"
    }
  },

  "icons": {
    "library": "lucide-react",
    "defaultSize": "20px",
    "strokeWidth": 1.5
  },

  "decisions": {
    "$description": "Design decisions made during token reconciliation. Document rationale for future reference.",
    "1": { "topic": "Example: Button shape", "choice": "rounded-md (8px)", "rationale": "Consistent with Tailwind defaults" }
  }
}
