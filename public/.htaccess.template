# {{PROD_DOMAIN}} — production Apache config (Metanet). Staging gets this SAME file plus overrides
# (noindex, no-cache) from deploy.yml, so an Apache error shows on staging before production.
# Basic auth on staging is a Plesk password-protected directory (server config), not this file.

Options -Indexes

# --- Compression ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml application/xml
</IfModule>

# --- Security headers: SR-HDR-01..09, SR-HOST-02, SR-HOST-03, SR-TLS-03 ---
# These headers only reach browsers when Plesk "Smart static files processing" and
# "Serve static files directly by nginx" are OFF (deploy-standard §5c).
# nginx's own HTTP→HTTPS redirect and error pages still carry none (WEB-01, held).
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set Permissions-Policy "camera=(), microphone=(), payment=(), geolocation=(), usb=()"
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
    # Scripts, fonts and styles are self-hosted; connect-src permits this project's Supabase API.
    # Add only the services the project uses to the policy below (one CSP header):
    # PostHog EU: add https://eu.i.posthog.com to connect-src.
    # Sentry: add https://{{SENTRY_INGEST_HOST}} to connect-src (the exact host from the project's DSN).
    # Stripe: add https://js.stripe.com to script-src; replace frame-src 'none' with
    # frame-src https://js.stripe.com; add https://api.stripe.com to connect-src.
    # No realtime subscriptions, embedded pages, workers, media, data images or inline script handlers.
    # Inline styles remain necessary for React layout and the static mail pages; they do not allow inline scripts.
    Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self' https://{{SUPABASE_PROJECT_REF}}.supabase.co; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; frame-src 'none'; worker-src 'none'; manifest-src 'self'"
    # Remove COOP only if the app opens a sign-in popup that must talk back.
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>

# --- Cache control ---
<IfModule mod_headers.c>
    # Hashed build assets (JS, CSS, fonts): immutable.
    <FilesMatch "\.(js|css|woff2|woff)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # HTML: always revalidate, so a new release is seen at once.
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(png|svg|webp|ico|jpg|jpeg|avif)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    # What crawlers read (sitemaps, robots.txt, llms.txt) is rebuilt with every release: revalidate.
    <FilesMatch "\.(xml|txt)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# --- Never serve these ---
<IfModule mod_authz_core.c>
    <FilesMatch "(?i)(^\.|^Credentials(?:\.|$)|^package(?:-lock)?\.json$|\.(?:map|sql|bak|orig)$|\.bak-|~$)">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Defense in depth if a future build ever copies a private tree. Keep ACME validation reachable.
    RewriteRule (^|/)(\.(?!well-known(?:/|$))[^/]*|docs|node_modules|backup|tmp)(/|$) - [F,L,NC]

    # HTTPS, then the one host name (single hop).
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

    # Client-side SPA routes; real files and directories keep their normal handlers.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>
